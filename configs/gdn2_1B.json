{
    "model_type": "gdn2",
    "attn_mode": "chunk",
    "hidden_size": 1616,
    "num_heads": 14,
    "head_dim": 128,
    "expand_v": 1.0,
    "num_hidden_layers": 24,
    "hidden_ratio": 4,
    "intermediate_size": 4352,
    "hidden_act": "swish",
    "use_short_conv": true,
    "conv_size": 4,
    "allow_neg_eigval": false,
    "fuse_norm": true,
    "fuse_swiglu": true,
    "fuse_cross_entropy": true,
    "use_cache": true,
    "vocab_size": 32000,
    "bos_token_id": 1,
    "eos_token_id": 2,
    "tie_word_embeddings": true,
    "initializer_range": 0.02,
    "norm_eps": 1e-6
}
