{
    "model_type": "mamba3",
    "hidden_size": 1024,
    "state_size": 64,
    "num_hidden_layers": 24,
    "expand": 2,
    "head_dim": 64,
    "n_groups": 1,
    "intermediate_size": 1920,
    "hidden_act": "swish",
    "rope_fraction": 0.5,
    "A_floor": 0.0001,
    "dt_min": 0.001,
    "dt_max": 0.1,
    "dt_init_floor": 0.0001,
    "is_mimo": true,
    "mimo_rank": 4,
    "chunk_size": 16,
    "is_outproj_norm": false,
    "use_bias": false,
    "fuse_norm": true,
    "fuse_swiglu": true,
    "fuse_cross_entropy": true,
    "use_cache": true,
    "residual_in_fp32": true,
    "rescale_prenorm_residual": true,
    "vocab_size": 32000,
    "bos_token_id": 1,
    "eos_token_id": 2,
    "tie_word_embeddings": true,
    "initializer_range": 0.02,
    "norm_eps": 1e-5
}
